# ======================
# 🌐 Server Configuration
# ======================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development
SERVER_READ_TIMEOUT=10       # секунды
SERVER_WRITE_TIMEOUT=10      # секунды
SERVER_IDLE_TIMEOUT=60       # секунды

# ======================
# 📋 Logger Configuration
# ======================
LOG_LEVEL=debug              # debug | info | warn | error
LOG_FORMAT=json              # json | text

# ======================
# 🌍 HTTP Client Configuration
# ======================
JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com
HTTP_CLIENT_TIMEOUT=5        # секунды
HTTP_RETRY_COUNT=3
HTTP_RETRY_WAIT_MS=200
HTTP_RETRY_MAX_WAIT_MS=2000
HTTP_RETRY_BACKOFF=exponential   # exponential | fixed